DESCRIPTION "IBM ABIOS DASD Device Driver"

PROTMODE

SEGMENTS
 DDHeader       CLASS 'DATA'
 CONST          CLASS 'CONST'
 _BSS           CLASS 'BSS'
 LIBDATA        CLASS 'DATA'
 _DATA          CLASS 'DATA'
 LIBCODE        CLASS 'CODE' IOPL
 'CODE'         CLASS 'CODE' IOPL
 _TEXT          CLASS 'CODE' IOPL

